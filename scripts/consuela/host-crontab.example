# Consuela dashboard host crontab — all six cron routes are POST-ONLY (-X POST required).
# On QNAP hosts, curl lives at /sbin/curl (cron's PATH may not include it — use the full path).
# Replace __replace_me__ with the container's CRON_SECRET value (docker inspect consuela-dashboard).
CONSUELA_CRON_SECRET=__replace_me__
*/5 * * * * curl -fs -m 10 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/consuela/suggestions >> ~/consuela-cron.log 2>&1
0 7 * * *   curl -fs -m 30 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/consuela/briefing        >> ~/consuela-cron.log 2>&1
*/5 * * * * curl -fs -m 30 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/consuela/google-sync     >> ~/consuela-cron.log 2>&1
*/5 * * * * curl -fs -m 30 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/consuela/telegram-poll  >> ~/consuela-cron.log 2>&1
*/5 * * * * curl -fs -m 30 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/consuela/ha-todo-mirror >> ~/consuela-cron.log 2>&1
*/15 * * * * curl -fs -m 30 -X POST -H "Authorization: Bearer $CONSUELA_CRON_SECRET" http://localhost:3000/api/cron/calendar/score-importance >> ~/consuela-cron.log 2>&1
