# PocketBase
NEXT_PUBLIC_PB_URL=http://pocketbase:8090
PB_ADMIN_EMAIL=admin@consuela.app
PB_ADMIN_PASS=your_pb_admin_password_here

# Google API integration
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/calendar
CONSUELA_ENCRYPTION_KEY=your_encryption_key_here

# Dashboard self-referencing (for internal tool calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron routes (POST /api/cron/consuela/*)
CRON_SECRET=changeme-please-set-me
# Server-only secret for internal admin self-calls (chat tools -> /api/admin/*).
# The browser uses a parent PIN instead; never expose this via NEXT_PUBLIC_.
ADMIN_SECRET=generate-a-long-random-string
# Signs dashboard session cookies (HMAC). Generate: openssl rand -base64 32
SESSION_SECRET=generate-a-long-random-string
# LAN HTTP deploys: keep session cookies non-Secure (default false).
SESSION_COOKIE_SECURE=false

# Hermes AI chat
HERMES_API_URL=http://192.168.0.28:9119
HERMES_API_KEY=your_hermes_api_key_here

# Alex's finance app (The Ledger) — proxied at /ledger-app, /assets, /api/data, /api/ofx.
# NAS value: http://finance-dashboard (container on familydashboard_consuela-net).
# Local dev runs on the Mac, which reaches the published port directly:
FINANCE_DASHBOARD_URL=http://192.168.0.28:9080

# Optional integrations
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MIRROR_BOT_TOKEN=

# Home Assistant
HA_HOST=http://homeassistant:8123
HA_TOKEN=your_long_lived_token
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_USER=
MQTT_PASS=
HA_GROCERY_TODO_NAME=Consuela Grocery

# Emergency email/SMS legs (email-to-SMS carrier gateways ride the same account)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Emergency/briefing Telegram push target chat id
TELEGRAM_ALERT_CHAT_ID=
# Instacart cart creation key (server-side; Settings can override at runtime)
INSTACART_API_KEY=
# Primary Instacart backend via Composio — set in Settings -> Services & Keys or env
COMPOSIO_API_KEY=
